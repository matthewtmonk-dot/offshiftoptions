generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Visibility {
  PRIVATE
  SHARED
}

enum AppearanceMode {
  DARK
  LIGHT
  SYSTEM
}

enum RecordVisibility {
  INHERIT
  PRIVATE
  SHARED
}

enum TradeStrategy {
  CASH_SECURED_PUT
}

enum CampaignStrategy {
  CASH_SECURED_PUT
  WHEEL
}

enum CampaignStatus {
  OPEN
  ASSIGNED
  CLOSED
}

enum CampaignEventType {
  SELL_PUT
  CLOSE_PUT
  ROLL_PUT_CLOSE
  ROLL_PUT_OPEN
  ASSIGNMENT
  SELL_COVERED_CALL
  CLOSE_COVERED_CALL
  COVERED_CALL_EXPIRED
  STOCK_SALE
  NOTE
}

enum AccountLedgerEntryType {
  STARTING_VALUE
  DEPOSIT
  WITHDRAWAL
  MANUAL_ADJUSTMENT
  BROKER_SNAPSHOT
  NOTE
}

enum AccountSource {
  MANUAL
  SCHWAB
}

enum TradeStatus {
  OPEN
  CLOSED
  EXPIRED
  ASSIGNED
  ROLLED
}

enum TradeLegAction {
  SELL_TO_OPEN
  BUY_TO_CLOSE
  EXPIRE
  ASSIGN
  ROLL_OPEN
  ROLL_CLOSE
}

enum WatchlistItemStatus {
  WATCHING
  RESEARCHING
  READY
  DO_NOT_TRADE
}

// The user's personal judgment of a ticker as a company/trade candidate - distinct from
// the Scanner's technical PASS/FAIL/UNKNOWN, which never changes based on this. Supersedes
// WatchlistItemStatus above (see the migration backfill and PROJECT_HANDOFF.md Research
// section): WATCHING->WATCH, RESEARCHING->NEUTRAL, READY->LIKE, DO_NOT_TRADE->NEVER_TRADE.
enum ResearchStatus {
  LIKE
  WATCH
  NEUTRAL
  AVOID
  NEVER_TRADE
}

enum WouldOwnStatus {
  YES
  NO
  CONDITIONAL
}

enum RollFriendliness {
  UNKNOWN
  FRIENDLY
  DIFFICULT
}

enum NoteCategory {
  PRO
  CON
  GENERAL
}

enum RecommendationStatus {
  NEW
  WATCHING
  PASSED
  ARCHIVED
}

enum ConversationType {
  PRIVATE
  GROUP
}

enum NotificationType {
  RECOMMENDATION
  COMMENT
  REACTION
  MESSAGE
  TRADE
  SYSTEM
}

enum ActivityType {
  WATCHLIST
  RECOMMENDATION
  COMMENT
  REACTION
  TRADE
  SCANNER
  LEARNING
}

enum ReactionKind {
  ATTA_BOY
  CHECKING
  NICE_MANAGEMENT
}

enum ReactionTargetType {
  WATCHLIST_ITEM
  RECOMMENDATION
  COMMENT
  TRADE
  ACTIVITY
}

enum ScannerOperator {
  LTE
  GTE
  BETWEEN
  EQ
  NEQ
  EXISTS
}

enum CriterionStatus {
  PASS
  FAIL
  UNKNOWN
}

enum OptionType {
  PUT
  CALL
}

enum BrokerProvider {
  MOCK
  SCHWAB
}

enum BrokerConnectionStatus {
  MOCK
  DISCONNECTED
  CONNECTED
  EXPIRED
}

enum SchwabDeveloperCredentialStatus {
  CONFIGURED
  VALIDATED
  INVALID
  REMOVED
}

enum BrokerRecordKind {
  TRANSACTION
  POSITION
  REALIZED_GAIN_LOSS
}

enum BrokerRecordSource {
  SCHWAB_API
  SCHWAB_TRANSACTIONS_CSV
  SCHWAB_POSITIONS_CSV
  SCHWAB_GAINLOSS_CSV
}

enum BrokerRecordStatus {
  CONFIRMED
  CONFLICT
  NEEDS_REVIEW
}

enum BrokerImportExportType {
  POSITIONS
  TRANSACTIONS
  REALIZED_GAIN_LOSS
}

enum BrokerImportBatchStatus {
  PENDING_PREVIEW
  CONFIRMED
  DISCARDED
}

model User {
  id                         String                      @id @default(cuid())
  name                       String
  email                      String                      @unique
  passwordHash               String
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  settings                   UserSettings?
  sharingPreferences         SharingPreferences?
  sessions                   Session[]
  accounts                   TradingAccount[]
  trades                     Trade[]
  watchlists                 Watchlist[]
  watchlistItems             WatchlistItem[]
  notes                      StockNote[]
  comments                   Comment[]
  recommendationsSent        Recommendation[]            @relation("SentRecommendations")
  recommendationsReceived    Recommendation[]            @relation("ReceivedRecommendations")
  conversationMemberships    ConversationMember[]
  chatMessages               ChatMessage[]
  chatReads                  ChatMessageRead[]
  reactions                  Reaction[]
  activities                 Activity[]
  notificationsSent          Notification[]              @relation("NotificationActor")
  notificationsReceived      Notification[]              @relation("NotificationRecipient")
  pushSubscriptions          PushSubscription[]
  scannerProfiles            ScannerProfile[]
  scannerRuns                ScanRun[]
  brokerConnections          BrokerConnection[]
  schwabDeveloperCredentials SchwabDeveloperCredential[]
  brokerRecords              BrokerRecord[]
  brokerImportBatches        BrokerImportBatch[]
  campaigns                  Campaign[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserSettings {
  id                  String         @id @default(cuid())
  userId              String         @unique
  darkMode            Boolean        @default(true)
  compactMode         Boolean        @default(false)
  // Appearance (Dark/Light/System) supersedes the unused legacy darkMode boolean above,
  // which no application code has ever read. Existing rows are backfilled to DARK by the
  // migration so no current user's visual experience changes; the column default then
  // switches to SYSTEM for accounts created afterward. See PROJECT_HANDOFF.md Appearance section.
  appearance          AppearanceMode @default(SYSTEM)
  enableInAppNotify   Boolean        @default(true)
  enableWebPushNotify Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SharingPreferences {
  id                    String     @id @default(cuid())
  userId                String     @unique
  defaultTrade          Visibility @default(SHARED)
  defaultPosition       Visibility @default(SHARED)
  defaultWatchlist      Visibility @default(SHARED)
  defaultNote           Visibility @default(SHARED)
  defaultRecommendation Visibility @default(SHARED)
  defaultAccountBalance Visibility @default(PRIVATE)
  defaultDollarPL       Visibility @default(PRIVATE)
  defaultPercentPL      Visibility @default(SHARED)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TradingAccount {
  id                 String               @id @default(cuid())
  userId             String
  name               String
  brokerName         String               @default("Manual")
  accountType        String               @default("Demo")
  currency           String               @default("USD")
  startingBalance    Decimal?             @db.Decimal(14, 2)
  manualBalance      Decimal?             @db.Decimal(14, 2)
  visibility         Visibility           @default(PRIVATE)
  source             AccountSource        @default(MANUAL)
  brokerConnectionId String?
  externalAccountId  String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerConnection   BrokerConnection?    @relation(fields: [brokerConnectionId], references: [id], onDelete: SetNull)
  snapshots          AccountSnapshot[]
  ledgerEntries      AccountLedgerEntry[]
  brokerRecords      BrokerRecord[]
  brokerImportBatches BrokerImportBatch[]
  trades             Trade[]
  campaigns          Campaign[]

  @@unique([userId, externalAccountId])
  @@index([userId, visibility])
}

model AccountSnapshot {
  id               String         @id @default(cuid())
  accountId        String
  capturedAt       DateTime       @default(now())
  accountValue     Decimal        @db.Decimal(14, 2)
  cash             Decimal        @db.Decimal(14, 2)
  cashSecuringPuts Decimal        @db.Decimal(14, 2)
  availableCash    Decimal        @db.Decimal(14, 2)
  realizedPL       Decimal        @db.Decimal(14, 2)
  unrealizedPL     Decimal        @db.Decimal(14, 2)
  premiumCollected Decimal        @db.Decimal(14, 2)
  account          TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, capturedAt])
}

model AccountLedgerEntry {
  id           String                 @id @default(cuid())
  accountId    String
  type         AccountLedgerEntryType
  occurredAt   DateTime
  amount       Decimal?               @db.Decimal(14, 2)
  accountValue Decimal?               @db.Decimal(14, 2)
  cash         Decimal?               @db.Decimal(14, 2)
  source       String                 @default("MANUAL")
  notes        String?
  createdAt    DateTime               @default(now())
  account      TradingAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, occurredAt])
  @@index([type])
}

model Trade {
  id                String             @id @default(cuid())
  userId            String
  accountId         String?
  strategy          TradeStrategy      @default(CASH_SECURED_PUT)
  symbol            String
  contracts         Int
  status            TradeStatus        @default(OPEN)
  visibility        Visibility         @default(SHARED)
  openedAt          DateTime
  closedAt          DateTime?
  notes             String?
  rolledFromTradeId String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  account           TradingAccount?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  rolledFromTrade   Trade?             @relation("TradeRollChain", fields: [rolledFromTradeId], references: [id])
  rolledToTrades    Trade[]            @relation("TradeRollChain")
  legs              TradeLeg[]
  positionSnapshots PositionSnapshot[]
  comments          Comment[]
  reactions         Reaction[]

  @@index([userId, visibility])
  @@index([symbol])
  @@index([status])
}

model TradeLeg {
  id         String         @id @default(cuid())
  tradeId    String
  action     TradeLegAction
  symbol     String
  contracts  Int
  strike     Decimal        @db.Decimal(12, 2)
  expiration DateTime
  openedAt   DateTime?
  closedAt   DateTime?
  premium    Decimal?       @db.Decimal(12, 4)
  price      Decimal?       @db.Decimal(12, 4)
  fees       Decimal        @default(0) @db.Decimal(12, 2)
  delta      Decimal?       @db.Decimal(10, 4)
  gamma      Decimal?       @db.Decimal(10, 4)
  theta      Decimal?       @db.Decimal(10, 4)
  vega       Decimal?       @db.Decimal(10, 4)
  createdAt  DateTime       @default(now())
  trade      Trade          @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId])
  @@index([symbol, expiration, strike])
}

model PositionSnapshot {
  id                String   @id @default(cuid())
  tradeId           String
  capturedAt        DateTime @default(now())
  stockPrice        Decimal  @db.Decimal(12, 2)
  optionBid         Decimal  @db.Decimal(12, 4)
  optionAsk         Decimal  @db.Decimal(12, 4)
  optionMark        Decimal  @db.Decimal(12, 4)
  delta             Decimal? @db.Decimal(10, 4)
  gamma             Decimal? @db.Decimal(10, 4)
  theta             Decimal? @db.Decimal(10, 4)
  vega              Decimal? @db.Decimal(10, 4)
  impliedVolatility Decimal? @db.Decimal(10, 4)
  openInterest      Int?
  optionVolume      Int?
  trade             Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId, capturedAt])
}

model Campaign {
  id                String           @id @default(cuid())
  ownerId           String
  accountId         String
  ticker            String
  strategy          CampaignStrategy @default(CASH_SECURED_PUT)
  status            CampaignStatus   @default(OPEN)
  visibility        RecordVisibility @default(INHERIT)
  openedAt          DateTime
  closedAt          DateTime?
  thesis            String?
  entrySnapshotJson Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  owner             User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  account           TradingAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  events            CampaignEvent[]
  linkedBrokerRecords BrokerRecord[]

  @@index([ownerId, status])
  @@index([accountId, status])
  @@index([ticker])
  @@index([visibility])
}

model CampaignEvent {
  id              String            @id @default(cuid())
  campaignId      String
  type            CampaignEventType
  occurredAt      DateTime
  sortOrder       Int               @default(0)
  groupKey        String?
  optionType      OptionType?
  contracts       Int?
  shares          Int?
  strike          Decimal?          @db.Decimal(12, 2)
  expiration      DateTime?
  premium         Decimal?          @db.Decimal(12, 4)
  cashAmount      Decimal?          @db.Decimal(14, 2)
  fees            Decimal           @default(0) @db.Decimal(12, 2)
  underlyingPrice Decimal?          @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime          @default(now())
  campaign        Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, occurredAt])
  @@index([campaignId, groupKey])
}

model Watchlist {
  id         String          @id @default(cuid())
  ownerId    String
  name       String
  visibility Visibility      @default(SHARED)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  owner      User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items      WatchlistItem[]

  @@index([ownerId, visibility])
}

model WatchlistItem {
  id          String              @id @default(cuid())
  watchlistId String
  ownerId     String
  ticker      String
  status      WatchlistItemStatus @default(WATCHING)
  // Research is PRIVATE BY DEFAULT (see PROJECT_HANDOFF.md Research section) - changed from
  // SHARED. Only affects new rows; existing rows keep whatever visibility they already had,
  // matching the same precedent used for TradingAccount's default-visibility change.
  visibility  Visibility          @default(PRIVATE)
  tags        String[]            @default([])
  addedAt     DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  // --- Research fields (2026-09 Scanner<->Research slice) ---
  researchStatus       ResearchStatus     @default(NEUTRAL)
  companyName          String?
  whatItDoes           String?
  wouldOwn             WouldOwnStatus?
  wouldOwnMaxPrice     Decimal?           @db.Decimal(12, 2)
  monthlyPutsOnly      Boolean            @default(false)
  rollFriendliness     RollFriendliness   @default(UNKNOWN)
  rollFriendlinessNote String?
  exclusionReason      String?
  manualSchwabGrade    String?
  manualLsegRating     String?
  manualLsegScore      String?
  manualLsegTarget     String?
  // Verified fundamentals (auto, from Schwab's quote "fundamental" field group) - left
  // unpopulated in this slice. No live Schwab connection was available locally to verify
  // field names/units against a real response; see PROJECT_HANDOFF.md Research section for
  // the exact next step before wiring these up. Never treat as a live quote.
  fundamentalPeRatio       Decimal?  @db.Decimal(10, 2)
  fundamentalPegRatio      Decimal?  @db.Decimal(10, 2)
  fundamentalDebtToEquity  Decimal?  @db.Decimal(10, 4)
  fundamentalCurrentRatio  Decimal?  @db.Decimal(10, 4)
  fundamentalEps           Decimal?  @db.Decimal(10, 4)
  fundamentalDividendYield Decimal?  @db.Decimal(10, 4)
  fundamentalSource        String?
  fundamentalAsOf          DateTime?

  watchlist   Watchlist           @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  owner       User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  notes       StockNote[]
  comments    Comment[]
  reactions   Reaction[]

  @@unique([watchlistId, ticker])
  @@index([ownerId, visibility])
  @@index([ownerId, researchStatus])
  @@index([ticker])
}

model StockNote {
  id              String         @id @default(cuid())
  ownerId         String
  ticker          String
  watchlistItemId String?
  category        NoteCategory
  body            String
  visibility      Visibility     @default(SHARED)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  owner           User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  watchlistItem   WatchlistItem? @relation(fields: [watchlistItemId], references: [id], onDelete: Cascade)

  @@index([ownerId, visibility])
  @@index([ticker])
}

model Comment {
  id               String          @id @default(cuid())
  authorId         String
  ticker           String?
  body             String
  visibility       Visibility      @default(SHARED)
  recommendationId String?
  tradeId          String?
  watchlistItemId  String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  author           User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  recommendation   Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  trade            Trade?          @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  watchlistItem    WatchlistItem?  @relation(fields: [watchlistItemId], references: [id], onDelete: Cascade)
  reactions        Reaction[]

  @@index([authorId, visibility])
  @@index([ticker])
}

model Recommendation {
  id          String               @id @default(cuid())
  senderId    String
  recipientId String
  ticker      String
  message     String
  reasonTags  String[]             @default([])
  visibility  Visibility           @default(SHARED)
  status      RecommendationStatus @default(NEW)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  sender      User                 @relation("SentRecommendations", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User                 @relation("ReceivedRecommendations", fields: [recipientId], references: [id], onDelete: Cascade)
  comments    Comment[]
  reactions   Reaction[]

  @@index([senderId])
  @@index([recipientId, status])
  @@index([ticker])
}

model Conversation {
  id        String               @id @default(cuid())
  title     String
  type      ConversationType     @default(PRIVATE)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  members   ConversationMember[]
  messages  ChatMessage[]
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model ChatMessage {
  id             String            @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  ticker         String?
  createdAt      DateTime          @default(now())
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reads          ChatMessageRead[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([ticker])
}

model ChatMessageRead {
  id        String      @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model Reaction {
  id               String             @id @default(cuid())
  actorId          String
  kind             ReactionKind
  targetType       ReactionTargetType
  tradeId          String?
  recommendationId String?
  watchlistItemId  String?
  commentId        String?
  activityId       String?
  createdAt        DateTime           @default(now())
  actor            User               @relation(fields: [actorId], references: [id], onDelete: Cascade)
  trade            Trade?             @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  recommendation   Recommendation?    @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  watchlistItem    WatchlistItem?     @relation(fields: [watchlistItemId], references: [id], onDelete: Cascade)
  comment          Comment?           @relation(fields: [commentId], references: [id], onDelete: Cascade)
  activity         Activity?          @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([targetType])
}

model Activity {
  id         String       @id @default(cuid())
  actorId    String
  type       ActivityType
  title      String
  body       String?
  ticker     String?
  visibility Visibility   @default(SHARED)
  createdAt  DateTime     @default(now())
  actor      User         @relation(fields: [actorId], references: [id], onDelete: Cascade)
  reactions  Reaction[]

  @@index([actorId, visibility])
  @@index([ticker])
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  actorId     String?
  type        NotificationType
  title       String
  body        String
  href        String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, readAt])
  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
}

model ScannerProfile {
  id         String        @id @default(cuid())
  ownerId    String
  name       String
  visibility Visibility    @default(PRIVATE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  owner      User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  rules      ScannerRule[]
  scanRuns   ScanRun[]

  @@unique([ownerId, name])
}

model ScannerRule {
  id        String          @id @default(cuid())
  profileId String
  key       String
  name      String
  operator  ScannerOperator
  valueJson Json
  enabled   Boolean         @default(true)
  sortOrder Int             @default(0)
  profile   ScannerProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, key])
  @@index([profileId, enabled])
}

model ScanRun {
  id        String         @id @default(cuid())
  profileId String
  ownerId   String
  source    String         @default("DEMO")
  createdAt DateTime       @default(now())
  profile   ScannerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  owner     User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  results   ScanResult[]

  @@index([ownerId, createdAt])
}

model ScanResult {
  id               String                @id @default(cuid())
  runId            String
  ticker           String
  summaryStatus    CriterionStatus
  passedCriteria   Int
  totalCriteria    Int
  snapshotJson     Json
  createdAt        DateTime              @default(now())
  run              ScanRun               @relation(fields: [runId], references: [id], onDelete: Cascade)
  criterionResults ScanCriterionResult[]

  @@index([runId])
  @@index([ticker])
}

model ScanCriterionResult {
  id            String          @id @default(cuid())
  scanResultId  String
  criterionName String
  actualValue   String?
  operator      String
  desiredValue  String
  status        CriterionStatus
  explanation   String
  scanResult    ScanResult      @relation(fields: [scanResultId], references: [id], onDelete: Cascade)

  @@index([scanResultId, status])
}

model MarketQuoteCache {
  symbol        String   @id
  price         Decimal  @db.Decimal(12, 2)
  change        Decimal? @db.Decimal(12, 2)
  changePercent Decimal? @db.Decimal(10, 4)
  asOf          DateTime
  source        String   @default("MOCK")
  updatedAt     DateTime @updatedAt
}

model PriceCandle {
  id       String   @id @default(cuid())
  symbol   String
  date     DateTime
  open     Decimal  @db.Decimal(12, 2)
  high     Decimal  @db.Decimal(12, 2)
  low      Decimal  @db.Decimal(12, 2)
  close    Decimal  @db.Decimal(12, 2)
  adjClose Decimal? @db.Decimal(12, 2)
  volume   BigInt

  @@unique([symbol, date])
  @@index([symbol])
}

model OptionContractSnapshot {
  id                String     @id @default(cuid())
  symbol            String
  underlyingSymbol  String
  optionType        OptionType
  strike            Decimal    @db.Decimal(12, 2)
  expiration        DateTime
  bid               Decimal    @db.Decimal(12, 4)
  ask               Decimal    @db.Decimal(12, 4)
  mark              Decimal    @db.Decimal(12, 4)
  last              Decimal?   @db.Decimal(12, 4)
  delta             Decimal?   @db.Decimal(10, 4)
  gamma             Decimal?   @db.Decimal(10, 4)
  theta             Decimal?   @db.Decimal(10, 4)
  vega              Decimal?   @db.Decimal(10, 4)
  impliedVolatility Decimal?   @db.Decimal(10, 4)
  openInterest      Int?
  volume            Int?
  capturedAt        DateTime   @default(now())

  @@index([underlyingSymbol, expiration, strike])
  @@index([symbol, capturedAt])
}

model BrokerConnection {
  id                     String                     @id @default(cuid())
  userId                 String
  developerCredentialId  String?
  provider               BrokerProvider
  label                  String
  status                 BrokerConnectionStatus     @default(DISCONNECTED)
  accessTokenCiphertext  String?
  refreshTokenCiphertext String?
  expiresAt              DateTime?
  scopes                 String[]                   @default([])
  metadata               Json?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  user                   User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  developerCredential    SchwabDeveloperCredential? @relation(fields: [developerCredentialId], references: [id], onDelete: SetNull)
  tradingAccounts        TradingAccount[]

  @@index([userId, provider])
  @@index([developerCredentialId])
}

model SchwabDeveloperCredential {
  id                          String                          @id @default(cuid())
  userId                      String
  provider                    BrokerProvider                  @default(SCHWAB)
  label                       String                          @default("Charles Schwab developer app")
  clientIdCiphertext          String
  clientSecretCiphertext      String
  redirectUri                 String
  status                      SchwabDeveloperCredentialStatus @default(CONFIGURED)
  marketDataEnabled           Boolean                         @default(true)
  appKeyLast4                 String?
  lastValidatedAt             DateTime?
  lastValidationFailureAt     DateTime?
  lastValidationFailureReason String?
  createdAt                   DateTime                        @default(now())
  updatedAt                   DateTime                        @updatedAt
  user                        User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerConnections           BrokerConnection[]

  @@unique([userId, provider])
  @@index([userId, status])
}

model BrokerRecord {
  id                String               @id @default(cuid())
  userId            String
  accountId         String?
  importBatchId     String?
  linkedCampaignId  String?
  provider          BrokerProvider       @default(SCHWAB)
  kind              BrokerRecordKind
  status            BrokerRecordStatus   @default(CONFIRMED)
  fingerprint       String
  identityKey       String
  reconciliationKey String?
  occurredAt        DateTime?
  observedAt        DateTime?
  symbol            String?
  underlyingSymbol  String?
  action            String?
  description       String?
  quantity          Decimal?             @db.Decimal(14, 4)
  price             Decimal?             @db.Decimal(14, 4)
  fees              Decimal?             @db.Decimal(14, 2)
  amount            Decimal?             @db.Decimal(14, 2)
  sources           BrokerRecordSource[] @default([])
  sourceIds         String[]             @default([])
  reconciliationDismissedAt DateTime?
  metadata          Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  account           TradingAccount?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  importBatch       BrokerImportBatch?   @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  linkedCampaign    Campaign?            @relation(fields: [linkedCampaignId], references: [id], onDelete: SetNull)

  @@unique([userId, provider, kind, fingerprint])
  @@index([userId, provider, kind])
  @@index([userId, reconciliationKey])
  @@index([userId, identityKey])
  @@index([importBatchId])
  @@index([linkedCampaignId])
}

model BrokerImportBatch {
  id                   String                  @id @default(cuid())
  userId               String
  accountId            String?
  provider             BrokerProvider          @default(SCHWAB)
  exportType           BrokerImportExportType
  safeOriginalFilename String
  fileFingerprint      String
  asOfAt               DateTime?
  status               BrokerImportBatchStatus @default(PENDING_PREVIEW)
  rowCount             Int                     @default(0)
  newCount             Int                     @default(0)
  duplicateCount       Int                     @default(0)
  conflictCount        Int                     @default(0)
  reviewCount          Int                     @default(0)
  invalidCount         Int                     @default(0)
  previewPayload       Json?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  user                 User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account              TradingAccount?         @relation(fields: [accountId], references: [id], onDelete: SetNull)
  records              BrokerRecord[]

  @@index([userId, status])
  @@index([userId, createdAt])
}
